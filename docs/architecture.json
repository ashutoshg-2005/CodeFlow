  "cards": [
    {
      "dot": "cyan",
      "title": "Client",
      "items": [
        "Ships as the codeflow-ai npm package",
        "Tools run locally, sandboxed to the project cwd",
        "Token cached at ~/.codeflow/auth.json, mode 0600"
      ]
    },
    {
      "dot": "emerald",
      "title": "Server",
      "items": [
        "Hono on Bun, containerised on Render",
        "requireAuth and requireCreditsBalance guard every route",
        "Tool contracts have no execute; calls stream to the CLI"
      ]
    },
    {
      "dot": "rose",
      "title": "Modes, state, billing",
      "items": [
        "PLAN is read-only; BUILD adds write, edit and bash",
        "Turns persist to Postgres once no tool call is pending",
        "Usage becomes credits in Polar; an empty balance is 402"
      ]
    }
  ]
