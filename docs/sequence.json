  "cards": [
    {
      "dot": "cyan",
      "title": "Local loopback",
      "items": [
        "Bun.serve binds port 0, so the port is only known at runtime",
        "That port travels inside the OAuth state and comes back in the redirect",
        "The listener stops as soon as the code arrives, or after five minutes"
      ]
    },
    {
      "dot": "rose",
      "title": "Why PKCE",
      "items": [
        "A random verifier is hashed with SHA-256 into the challenge",
        "Only the CLI holds the verifier, so an intercepted code cannot be redeemed",
        "The state nonce is checked before the code is exchanged"
      ]
    },
    {
      "dot": "emerald",
      "title": "After sign-in",
      "items": [
        "The token is written to ~/.codeflow/auth.json with owner-only permissions",
        "Every API call replays it as a Bearer header",
        "A 401 from any route clears the cached token and forces a new login"
      ]
    }
  ]
}