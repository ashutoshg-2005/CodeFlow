      "variant": "default"
    },
    {
      "id": "bounce-local",
      "from": "api",
      "to": "browser",
      "y": 335,
      "label": "302 to localhost:port",
      "variant": "return"
    },
    {
      "id": "deliver-code",
      "from": "browser",
      "to": "loopback",
