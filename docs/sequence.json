      "label": "CodeFlow CLI",
      "sublabel": "performLogin()"
    },
    {
      "id": "loopback",
      "type": "backend",
      "label": "Loopback Server",
      "sublabel": "Bun.serve · port 0"
    },
    {
      "id": "browser",
      "type": "external",
      "label": "Browser",
      "sublabel": "system default"
    },
    {
      "id": "clerk",
      "type": "security",
      "label": "Clerk",
      "sublabel": "OAuth 2.0 provider"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "CodeFlow API",
      "sublabel": "/auth/callback"
    }
  ],
  "segments": [
