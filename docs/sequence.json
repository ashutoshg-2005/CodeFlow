    "views": [
      {
        "id": "launch",
        "label": "Launch and consent",
        "focus": [
          "cli",
          "loopback",
          "browser",
          "clerk"
        ],
        "note": "The CLI opens a loopback listener, then hands the user to the browser for consent."
      },
      {
        "id": "handoff",
        "label": "Hosted callback",
        "focus": [
          "browser",
          "api",
          "loopback"
        ],
        "note": "Clerk redirects to one fixed hosted URL, which bounces the code to the port the CLI is listening on."
      },
      {
        "id": "exchange",
        "label": "Token exchange",
        "focus": [
          "loopback",
          "clerk"
        ],
        "note": "The authorization code is redeemed with the PKCE verifier the CLI never sent anywhere."
      }
    ]
  },
  "participants": [
