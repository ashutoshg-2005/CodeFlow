{
  "info": {
    "name": "CodeFlow API",
    "description": "Black-box API tests of the CodeFlow server. Run against the stub server: `bun testing/automation/api-tests.ts --serve`. Tokens are stub users: tokenOk (100 credits), tokenZero (0), tokenNeg (-1), tokenOne (1), tokenDown (credits look-up fails).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response time is under 2000 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(2000); });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth callback (GET /auth/callback)",
      "item": [
        {
          "name": "AC-01 OAuth error is returned to the user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Body is the error description\", function () { pm.expect(pm.response.text()).to.eql(\"Access was denied\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/callback?error=access_denied&error_description=Access%20was%20denied",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "callback"
              ],
              "query": [
                {
                  "key": "error",
                  "value": "access_denied"
                },
                {
                  "key": "error_description",
                  "value": "Access%20was%20denied"
                }
              ]
            }
          }
        },
        {
          "name": "AC-02 Missing code and state",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Body explains what is missing\", function () { pm.expect(pm.response.text()).to.eql(\"Missing authorization code or state\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/callback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "callback"
              ]
            }
          }
        },
        {
          "name": "AC-03 Malformed state",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Body is 'Invalid authentication state'\", function () { pm.expect(pm.response.text()).to.eql(\"Invalid authentication state\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/callback?code=abc&state=not-valid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "abc"
                },
                {
                  "key": "state",
                  "value": "not-valid"
                }
              ]
            }
          }
        },
        {
          "name": "AC-04 Valid state redirects to the CLI's loopback port",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 302\", function () { pm.response.to.have.status(302); });",
                  "pm.test(\"Redirects to http://localhost:5555/callback with code and state\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"http://localhost:5555/callback?code=abc&state=eyJwb3J0Ijo1NTU1fQ.sig\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/callback?code=abc&state=eyJwb3J0Ijo1NTU1fQ.sig",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "abc"
                },
                {
                  "key": "state",
                  "value": "eyJwb3J0Ijo1NTU1fQ.sig"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
